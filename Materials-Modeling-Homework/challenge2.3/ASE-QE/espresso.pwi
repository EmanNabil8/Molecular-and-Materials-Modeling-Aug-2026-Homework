&CONTROL
   calculation      = 'scf'
   verbosity        = 'low'
   tstress          = .true.
   tprnfor          = .true.
   outdir           = './tmp'
   prefix           = 'si'
   etot_conv_thr    = 1e-05
   forc_conv_thr    = 0.0005
   pseudo_dir       = './'
/
&SYSTEM
   ibrav            = 0
   nat              = 2
   ntyp             = 1
   ecutwfc          = 65
   occupations      = 'smearing'
   degauss          = 0.01
   smearing         = 'gauss'
/
&ELECTRONS
   conv_thr         = 1e-10
/
&IONS
/
&CELL
/
&FCP
/
&RISM
/
