&CONTROL
   calculation      = 'vc-relax'
   tstress          = .true.
   tprnfor          = .true.
   pseudo_dir       = './'
   etot_conv_thr    = 1.0d-5
   forc_conv_thr    = 5.0d-4
/
&SYSTEM
   ibrav            = 0
   nat              = 2
   ntyp             = 1
   ecutwfc          = 45
   occupations      = 'smearing'
   smearing         = 'gauss'
   degauss          = 0.01
/
&ELECTRONS
   conv_thr         = 1e-10
/
&IONS
  ion_dynamics = "bfgs"
/
&CELL
  cell_dynamics = "bfgs"
/

ATOMIC_SPECIES
Si 28.085 Si.upf

K_POINTS automatic
12 12 12  0 0 0

CELL_PARAMETERS angstrom
    0.0000000000     2.7149000000     2.7149000000
    2.7149000000     0.0000000000     2.7149000000
    2.7149000000     2.7149000000     0.0000000000

ATOMIC_POSITIONS angstrom
Si       1.4074500000     4.0723500000     4.0723500000
Si       0.0000000000     0.0000000000     0.0000000000  
